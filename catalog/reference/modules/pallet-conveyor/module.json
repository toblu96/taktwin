  "devices": [
    {
      "type": "motorController",
      "id": "drive"
    },
    {
      "type": "solid",
      "id": "bumper",
      "box": {
        "from": ["length - 34", -570, "height - 10"],
        "to": ["length", 570, "height + 110"]
      },
      "label": "The end bumper"
    }
  ],
  "transport": [
    {
      "id": "surface",
      "label": "rollers",
      "drive": "drive.forward",
      "reverse": "drive.backward",
      "factor": "drive.factor",
      "speed": "speed",
      "path": {
        "line": {
          "from": [0, 0, "height"],
          "to": ["length", 0, "height"]
        }
      }
    }
  ],
  "modules": [
    {
      "id": "io",
      "module": "io-block",
      "name": "I/O block",
      "optional": true,
      "place": {
        "on": ".front",
        "at": "ioAt"
      }
    },
    {
      "id": "start",
      "module": "photo-sensor",
      "name": "B1 Pallet at start",
      "optional": true,
      "place": {
        "on": ".rear",
        "at": "startAt"
      },
      "params": {
        "diffuse": true,
        "reach": 600
      }
    },
    {
      "id": "atStop",
      "module": "photo-sensor",
      "name": "B2 Pallet at the stop",
      "optional": true,
      "place": {
        "on": ".front",
        "at": "stopAt - 60"
      }
    },
    {
      "id": "end",
      "module": "photo-sensor",
      "name": "B3 Pallet at end",
      "optional": true,
      "place": {
        "on": ".front",
        "at": "endAt"
      }
    },
    {
      "id": "stop",
      "module": "pallet-stop",
      "name": "Pallet stop",
      "optional": true,
      "place": {
        "on": ".bed",
        "at": "stopAt"
      }
    }
  ],
  "cables": [
    {
      "from": "X1",
      "to": "io.X1"
    }
  ],
  "wires": [
    {
      "from": "io.T.Q0",
      "to": "W.run"
    },
    {
      "from": "io.T.Q1",
      "to": "stop.W.release"
    },
    {
      "from": "io.T.I0",
      "to": "start.W.out"
    },
    {
      "from": "io.T.I1",
      "to": "atStop.W.out"
    },
    {
      "from": "io.T.I2",
      "to": "end.W.out"
    },
    {
      "from": "io.T.I3",
      "to": "stop.W.lowered"
    }
  ],
  "terminal": {
    "connectors": [
      {
        "id": "X1",
        "type": "m23-io"
      },
      {
        "id": "W",
        "type": "wires",
        "pins": [
          {
            "pin": "run",
            "function": "Run the rollers",
            "drives": "drive.clockwise"
          }
        ]
      }
    ]
  },
  "sites": [
    {
      "id": "front",
      "type": "frame-side",
      "from": [0, -578, "height - 60"],
      "range": ["guideFrom", "length - 500"]
    },
    {
      "id": "rear",
      "type": "frame-side",
      "from": [0, 578, "height - 60"],
      "range": [150, "length - 150"],
      "turn": 180
    },
    {
      "id": "bed",
      "type": "roller-bed",
      "from": [0, 0, "height - 30"],
      "range": [300, "length - 300"]
    }
  ],
  "actions": [
    {
      "id": "put",
      "type": "placeWorkpiece",
      "transport": "surface",
      "at": "startAt",
      "family": "pallet"
    },
    {
      "id": "takeAway",
      "type": "clearTransport",
      "label": "Take the pallet away",
      "over": ["length - 650", 0, "height"]
    },
    {
      "id": "takeAtStop",
      "type": "clearTransport",
      "label": "Take the pallet at the stop away",
      "over": ["stopAt - 600", 0, "height"]
    }
  ]
}
