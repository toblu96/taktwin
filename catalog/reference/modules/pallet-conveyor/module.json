{
  "format": 2,
  "id": "pallet-conveyor",
  "version": 1,
  "name": "Pallet conveyor",
  "description": "A roller conveyor for pallets of 1200 x 800 mm, lengthwise, driven by a gear motor at its end. It comes with three light barriers, at its start, in front of its stop and at its end, a pallet stop between its rollers, and an I/O block on its front frame. A bumper at its end holds pallets back.",
  "parameters": [
    {
      "id": "length",
      "default": 4800,
      "label": "Length",
      "unit": "mm",
      "kind": "build",
      "description": "How long the conveyor is, in steps of one roller.",
      "min": 1800,
      "max": 9600,
      "step": 150
    },
    {
      "id": "height",
      "default": 540,
      "label": "Height",
      "unit": "mm",
      "kind": "build",
      "description": "How high the rollers carry the pallets above the floor rails.",
      "min": 400,
      "max": 900,
      "step": 10
    },
    {
      "id": "speed",
      "default": 200,
      "label": "Speed",
      "unit": "mm/s",
      "kind": "physics",
      "description": "How fast the rollers carry a pallet.",
      "min": 50,
      "max": 600,
      "step": 10
    },
    {
      "id": "legs",
      "default": 5
    },
    {
      "id": "guides",
      "default": 6
    },
    {
      "id": "startAt",
      "default": 700
    },
    {
      "id": "stopAt",
      "default": 3000
    },
    {
      "id": "endAt",
      "default": "length - 520"
    },
    {
      "id": "ioAt",
      "default": "length - 1000"
    },
    {
      "id": "guideFrom",
      "default": "startAt + 700"
    }
  ],
  "needs": [
    {
      "module": "io-block",
      "why": "its motor and sensors are not connected to the PLC"
    }
  ],
  "mounts": [
    {
      "id": "floor",
      "type": "floor-rail",
      "at": [0, 0, 0],
      "screws": [
        [100, -600, 0],
        [100, 600, 0],
        ["length - 100", -600, 0],
        ["length - 100", 600, 0]
      ]
    }
  ],
