{
  "format": 2,
  "id": "pallet-magazine",
  "version": 1,
  "name": "Pallet magazine",
  "description": "A stack of empty pallets between four corner posts. Its push-out cylinder behind the stack pushes the bottom pallet out of the stack and onto a conveyor in front of it, where it leaves it. A light barrier across the bottom of the stack says when the magazine is empty.",
  "parameters": [
    {
      "id": "height",
      "default": 540,
      "label": "Height",
      "unit": "mm",
      "kind": "build",
      "description": "How high the bottom of the stack is above the floor rails: that of the conveyor the pallets go onto.",
      "min": 400,
      "max": 900,
      "step": 10
    },
    {
      "id": "stroke",
      "default": 1200,
      "label": "Stroke",
      "unit": "mm",
      "kind": "build",
      "description": "How far the cylinder pushes a pallet: from the middle of the stack to the middle of the conveyor.",
      "min": 900,
      "max": 1600,
      "step": 50
    },
    {
      "id": "speed",
      "default": 250,
      "label": "Speed",
      "unit": "mm/s",
      "kind": "physics",
      "description": "How fast the cylinder pushes.",
      "min": 50,
      "max": 800,
      "step": 10
    },
    {
      "id": "capacity",
      "default": 8
    }
  ],
  "needs": [
    {
      "module": "io-block",
      "why": "its cylinder and sensors are not connected to the PLC"
    }
  ],
  "mounts": [
    {
      "id": "floor",
      "type": "floor-rail",
      "at": [0, 0, 0],
      "screws": [
        [-600, -400, 0],
        [600, -400, 0],
        [-600, 400, 0],
        [600, 400, 0]
      ]
    }
  ],
