  "joints": [
    {
      "node": "plate",
      "type": "prismatic",
      "axis": [0, 1, 0],
      "range": [0, "stroke"],
      "driver": "push.position"
    }
  ],
  "devices": [
    {
      "type": "cylinder",
      "id": "push",
      "valve": "monostable",
      "rest": "retracted",
      "stroke": "stroke",
      "speed": "speed"
    },
    {
      "type": "reedSwitch",
      "id": "back",
      "cylinder": "push",
      "at": "retracted"
    },
    {
      "type": "reedSwitch",
      "id": "out",
      "cylinder": "push",
      "at": "extended"
    },
    {
      "type": "pusher",
      "id": "pusher",
      "cylinder": "push",
      "from": "stack",
      "to": "chute"
    },
    {
      "type": "solid",
      "id": "keeper",
      "node": "plate",
      "box": {
        "from": [-560, "-stroke - 60", 0],
        "to": [560, -20, 140]
      },
      "label": "The keeper of the magazine"
    },
    {
      "type": "sensor",
      "id": "bottom",
      "detect": "beam",
      "threshold": 50,
      "origin": [-690, 0, "height + 70"],
      "direction": [1, 0, 0],
      "reach": 1380
    },
    {
      "type": "lamp",
      "id": "emptyLamp",
      "node": "emptyLed",
      "on": "#ffb84d",
      "off": "#4d3a2a",
      "state": "bottom.detected",
      "glow": 12
    }
  ],
  "transport": [
    {
      "id": "stack",
      "label": "stack",
      "speed": 2000,
      "path": {
        "line": {
          "from": [0, 0, "height + capacity * 144 + 120 - 150"],
          "to": [0, 0, "height"]
        }
      }
    },
    {
      "id": "chute",
      "static": true,
      "path": {
        "line": {
          "from": [0, 0, "height"],
          "to": [0, "stroke", "height"]
        }
      }
    }
  ],
  "modules": [
    {
      "id": "io",
      "module": "io-block",
      "name": "I/O block",
      "optional": true,
      "at": [-300, -300, "height - 130"],
      "rotateZ": 0
    }
  ],
  "cables": [
    {
      "from": "X1",
      "to": "io.X1"
    }
  ],
  "wires": [
    {
      "from": "io.T.Q0",
      "to": "W.push"
    },
    {
      "from": "io.T.I0",
      "to": "W.isBack"
    },
    {
      "from": "io.T.I1",
      "to": "W.isOut"
    },
    {
      "from": "io.T.I2",
      "to": "W.isEmpty"
    }
  ],
  "terminal": {
    "connectors": [
      {
        "id": "X1",
        "type": "m23-io"
      },
      {
        "id": "W",
        "type": "wires",
        "pins": [
          {
            "pin": "push",
            "function": "Push a pallet out",
            "drives": "push.extend"
          },
          {
            "pin": "isBack",
            "function": "Pusher back",
            "reads": "back.on"
          },
          {
            "pin": "isOut",
            "function": "Pusher out",
            "reads": "out.on"
          },
          {
            "pin": "isEmpty",
            "function": "Magazine empty",
            "reads": "bottom.free"
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "id": "fill",
      "type": "placeWorkpiece",
      "transport": "stack",
      "at": 0,
      "family": "pallet",
      "heading": [1, 0, 0],
      "dock": true
    },
    {
      "id": "empty",
      "type": "clearTransport",
      "transport": "stack",
      "label": "Empty",
      "dock": true
    }
  ],
  "controls": [
    {
      "type": "fill",
      "label": "Pallets",
      "transport": "stack",
      "capacity": "capacity"
    },
    {
      "type": "button",
      "label": "Empty",
      "action": "empty"
    }
  ]
}
