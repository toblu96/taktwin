{
  "format": 5,
  "id": "pallet-loading",
  "name": "Pallet loading",
  "description": "Loads pallets with cartons. A pallet is pushed out of the magazine onto the roller conveyor and runs to the stop. There the gantry takes the cartons that the belt behind brings, one by one, and sets them onto the pallet in two layers of four. The full pallet then runs to the end of the conveyor to be taken away.",
  "workpieces": "pallet-loads",
  "modules": [
    {
      "id": "base",
      "module": "base-plate",
      "params": {
        "width": 6000,
        "depth": 5200,
        "feet": 5
      }
    },
    {
      "id": "cabinet",
      "module": "control-cabinet",
      "name": "Control cabinet",
      "place": {
        "on": "base.rails",
        "slot": 0,
        "at": 700
      }
    },
    {
      "id": "console",
      "module": "operator-console",
      "name": "Operator console",
      "place": {
        "on": "base.rails",
        "slot": 2,
        "at": 1900
      }
    },
    {
      "id": "conveyor",
      "module": "pallet-conveyor",
      "name": "Pallet conveyor",
      "place": {
        "on": "base.rails",
        "slot": 14,
        "at": -2400
      }
    },
    {
      "id": "magazine",
      "module": "pallet-magazine",
      "name": "Pallet magazine",
      "place": {
        "on": "base.rails",
        "slot": 8,
        "at": -1700
      }
    },
    {
      "id": "cartons",
      "module": "carton-conveyor",
      "name": "Carton conveyor",
      "place": {
        "on": "base.rails",
        "slot": 21,
        "at": -600
      }
    },
    {
      "id": "gantry",
      "module": "xyz-gantry",
      "name": "Gantry",
      "place": {
        "on": "base.rails",
        "slot": 10,
        "at": -600
      },
      "params": {
        "spanX": 2000,
        "spanY": 2600,
        "height": 2400,
        "xStart": 200,
        "yStart": 400,
        "tipTop": 1940,
        "strokeX": 1600,
        "strokeY": 1800,
        "strokeZ": 1000,
        "x0": 1500,
        "x1": 100,
        "x2": 700,
        "y0": 1800,
        "y1": 200,
        "y2": 600,
        "z0": 0,
        "z1": 900,
        "z2": 955,
        "z3": 655
      }
    }
  ],
  "cables": [
    {
      "from": "conveyor.X1",
      "to": "cabinet.X1"
    },
    {
      "from": "magazine.X1",
      "to": "cabinet.X2"
    },
    {
      "from": "gantry.X1",
      "to": "cabinet.X3"
    },
    {
      "from": "gantry.X2",
      "to": "cabinet.X4"
    },
    {
      "from": "cartons.X1",
      "to": "cabinet.X5"
    },
    {
      "from": "console.X1",
      "to": "cabinet.X6"
    }
  ],
  "docks": [
    {
      "place": "bottom",
      "widgets": [
        {
          "type": "group",
          "label": "Pallet magazine",
          "widgets": [
            {
              "type": "button",
              "label": "Pallet",
              "action": "magazine.fill",
              "args": {
                "kind": "pallet"
              },
              "swatch": "#dcbf8f"
            },
            {
              "type": "fill",
              "transport": "magazine.stack",
              "capacity": 8
            },
            {
              "type": "button",
              "label": "Empty",
              "action": "magazine.empty"
            }
          ]
        },
        {
          "type": "group",
          "label": "Cartons onto the belt",
          "widgets": [
            {
              "type": "button",
              "label": "Large carton",
              "action": "cartons.put",
              "args": {
                "kind": "carton-large"
              },
              "swatch": "#bf8f58"
            },
            {
              "type": "button",
              "label": "Small carton",
              "action": "cartons.put",
              "args": {
                "kind": "carton-small"
              },
              "swatch": "#c99b63"
            },
            {
              "type": "button",
              "label": "Clear the belt",
              "action": "cartons.empty"
            }
          ]
        },
        {
          "type": "group",
          "label": "Take away",
          "widgets": [
            {
              "type": "button",
              "label": "Pallet at the stop",
              "action": "conveyor.takeAtStop"
            },
            {
              "type": "button",
              "label": "Pallet at the end",
              "action": "conveyor.takeAway"
            }
          ]
        }
      ]
    }
  ],
  "plc": {
