{
  "format": 2,
  "id": "operator-console",
  "version": 1,
  "group": "PLC and I/O",
  "name": "Operator console",
  "role": "console",
  "description": "A console on a pedestal: Start, Stop and Reset buttons, a key switch for automatic or manual mode, an emergency stop, and a stack light with a green and an amber lamp. The emergency stop latches when pressed and is released by pulling it; while it is pressed, and until Reset is pressed after it, the safety relay keeps the actuators of the station without power. One M23 cable takes it to the PLC.",
  "mounts": [
    {
      "id": "floor",
      "type": "floor-rail",
      "at": [0, 0, 0],
      "screws": [
        [-100, 0, 0],
        [100, 0, 0]
      ]
    }
  ],
  "model": [
    {
