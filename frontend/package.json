{
  "name": "taktwin-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "vue-tsc && vite build --minify false --mode development",
    "build": "vue-tsc && vite build --mode production",
    "preview": "vite preview",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src",
    "lint": "oxlint --deny-warnings src"
  },
  "dependencies": {
    "@wailsio/runtime": "^3.1.0",
    "three": "^0.187.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
