{
  "$defs": {
    "GeometryDef": {
      "additionalProperties": false,
      "description": "GeometryDef uses the names and parameters of three.js geometries where one exists. From and To on a CylinderGeometry, and SectorGeometry, are extensions. ExtrudeGeometry takes its Shape as Points and Holes, and extrudes along +z.",
      "properties": {
        "center": {
          "items": {
            "$ref": "#/$defs/Num"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "depth": {
          "$ref": "#/$defs/Num"
        },
        "end": {
          "$ref": "#/$defs/Num"
        },
        "from": {
          "items": {
            "$ref": "#/$defs/Num"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "height": {
          "$ref": "#/$defs/Num"
        },
        "holes": {
          "items": {
            "items": {
              "items": {
                "$ref": "#/$defs/Num"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": "array"
          },
          "type": "array"
        },
        "inner": {
          "$ref": "#/$defs/Num"
        },
        "innerStart": {
          "$ref": "#/$defs/Num"
        },
        "outer": {
          "$ref": "#/$defs/Num"
        },
        "points": {
          "items": {
            "items": {
              "$ref": "#/$defs/Num"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "radialSegments": {
          "$ref": "#/$defs/Num"
        },
        "radius": {
          "$ref": "#/$defs/Num"
        },
        "start": {
          "$ref": "#/$defs/Num"
        },
        "to": {
          "items": {
            "$ref": "#/$defs/Num"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "type": {
          "type": "string"
        },
        "width": {
          "$ref": "#/$defs/Num"
        }
      },
      "type": "object"
    },
    "LabelDef": {
      "additionalProperties": false,
      "description": "LabelDef draws text on a node, on a plate if it has a Background.",
      "properties": {
        "background": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/Num"
        },
        "text": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "MarkDef": {
      "additionalProperties": false,
      "description": "MarkDef is something a process leaves on a workpiece, such as a hole or a filling, and how the 3D view shows it. Fill draws it as a filling inside the workpiece that rises that many mm per unit, and Hole as a hole of that diameter into its top.",
      "properties": {
        "fill": {
          "type": "number"
        },
        "hole": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "material": {
          "$ref": "#/$defs/Material"
        }
      },
      "type": "object"
    },
    "Material": {
      "additionalProperties": false,
      "description": "Material uses the names of three.js material classes and parameters.",
      "properties": {
        "color": {
          "type": "string"
        },
        "opacity": {
          "type": "number"
        },
        "shininess": {
          "type": "integer"
        },
        "specular": {
          "type": "string"
        },
        "type": {
          "description": "MeshLambertMaterial or MeshPhongMaterial",
          "type": "string"
        }
      },
      "type": "object"
    },
    "NodeDef": {
      "additionalProperties": false,
      "description": "NodeDef is one element of a module's 3D model, shaped like a three.js Object3D. Rotation is in degrees. Logic refers to nodes by Name and never to their shape, so a node can be refined without touching the module's behaviour.",
      "properties": {
        "belt": {
          "description": "transport a belt surface follows",
          "type": "string"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/NodeDef"
          },
          "type": "array"
        },
        "geometry": {
          "$ref": "#/$defs/GeometryDef"
        },
        "label": {
          "$ref": "#/$defs/LabelDef"
        },
        "material": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "noPick": {
          "type": "boolean"
        },
        "part": {
          "description": "shared part drawn at this node",
          "type": "string"
        },
        "position": {
          "items": {
            "$ref": "#/$defs/Num"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "repeat": {
          "$ref": "#/$defs/RepeatDef"
        },
        "rotation": {
          "items": {
            "$ref": "#/$defs/Num"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "when": {
          "$ref": "#/$defs/Num"
        }
      },
      "type": "object"
    },
    "Num": {
      "description": "A number, an expression over the module's parameters as a string, such as \"length - 47\" or \"radius * sin(45)\", or true or false for 1 or 0. Angles are degrees.",
      "type": [
        "number",
        "string",
        "boolean"
      ]
    },
    "OntoDef": {
      "additionalProperties": false,
      "description": "OntoDef is what a workpiece kind joins: the family it goes onto, and how deep in mm it sinks into it.",
      "properties": {
        "depth": {
          "type": "number"
        },
        "family": {
          "type": "string"
        },
        "free": {
          "description": "Free lets it go anywhere on top of the other one and stay where it was put, also onto what was put there before, as boxes stacked on a pallet. Without it, it only goes onto the middle of the other one's top, as a cap.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "RepeatDef": {
      "additionalProperties": false,
      "description": "RepeatDef places copies of a node along a step.",
      "properties": {
        "count": {
          "$ref": "#/$defs/Num"
        },
        "step": {
          "items": {
            "$ref": "#/$defs/Num"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "type": "object"
    },
    "WorkpieceKind": {
      "additionalProperties": false,
      "description": "WorkpieceKind is one variant of a workpiece set.",
      "properties": {
        "family": {
          "description": "Family tells apart what is not interchangeable in one set, such as bodies and lids.",
          "type": "string"
        },
        "height": {
          "description": "Height overrides the set's height, for a set that differs in height.",
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "material": {
          "$ref": "#/$defs/Material"
        },
        "metal": {
          "type": "boolean"
        },
        "model": {
          "description": "Model is how it looks, as nodes of parts like a module's, drawn from the middle of its base. A kind with a size and no model is a plain block of its material.",
          "items": {
            "$ref": "#/$defs/NodeDef"
          },
          "type": "array"
        },
        "onto": {
          "$ref": "#/$defs/OntoDef",
          "description": "Onto lets it join a workpiece of another family that it is set down or dropped onto, as a lid onto a body."
        },
        "points": {
          "description": "Points overrides the set's profile. Height is then the height of that profile.",
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "reflectivity": {
          "description": "Reflectivity is the percentage of light it sends back to an optical sensor, and Transparency the percentage it lets through a beam.",
          "type": "number"
        },
        "size": {
          "description": "Size makes it a rectangular block of that length and width in mm, as a pallet or a cardboard box, instead of round with the set's diameter. Its length points along its heading, which is the transport's where it is put on one.",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "transparency": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "WorkpieceSet": {
      "additionalProperties": false,
      "description": "WorkpieceSet is the content of a workpieces file. Points is the profile of a three.js LatheGeometry.",
      "properties": {
        "diameter": {
          "type": "number"
        },
        "format": {
          "type": "integer"
        },
        "height": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "kinds": {
          "items": {
            "$ref": "#/$defs/WorkpieceKind"
          },
          "type": "array"
        },
        "marks": {
          "description": "Marks are what processes can leave on these workpieces.",
          "items": {
            "$ref": "#/$defs/MarkDef"
          },
          "type": "array"
        },
        "points": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/toblu96/taktwin/main/schema/workpieces.schema.json",
  "$ref": "#/$defs/WorkpieceSet",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "workpieces/<id>.json: the shape and kinds of the workpieces a station works with.",
  "title": "Workpiece set"
}
